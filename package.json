{
  "name": "react-graphql-list-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --import tsx api/server.local.ts",
    "dev:all": "node --import tsx api/server.local.ts & vite",
    "dev:vercel": "vercel dev --listen ${VITE_PORT:-3001}",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint:check": "biome check --no-errors-on-unmatched",
    "lint:fix": "biome check --write --unsafe --no-errors-on-unmatched",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=chromium"
  },
  "dependencies": {
    "@heroui/react": "2.8.10",
    "@heroui/theme": "2.4.26",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-router-devtools": "^1.167.1",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.29",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "graphql-yoga": "^5.21.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vercel": "^58.9.0",
    "vite": "^8.2.1",
    "tsx": "^4.23.12"
  }
}
