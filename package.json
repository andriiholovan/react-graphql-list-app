{
  "name": "react-graphql-list-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --import tsx api/server.local.ts",
    "dev:all": "node --import tsx api/server.local.ts & vite",
    "dev:vercel": "vercel dev --listen ${VITE_PORT:-3001}",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint:check": "biome check --no-errors-on-unmatched",
    "lint:fix": "biome check --write --unsafe --no-errors-on-unmatched",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=chromium"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/theme": "2.4.26",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.47",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "graphql-yoga": "^5.24.6",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vercel": "^60.1.3",
    "vite": "^8.3.4",
    "tsx": "^4.23.15"
  }
}
